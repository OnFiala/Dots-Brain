[Unit]
Description=Dots Brain private memory and audit
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=dots-brain
Group=dots-brain
WorkingDirectory=/var/lib/dots-brain
ExecStart=/opt/dots-brain/current/.venv/bin/dots-brain --data-dir /var/lib/dots-brain serve --transport http --port 8787 --semantic --public-gateway
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
Environment=HF_HUB_OFFLINE=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dots-brain
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
CPUQuota=200%
MemoryHigh=1536M
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=multi-user.target
